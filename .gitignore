.env
*pycache*
*.ipynb
*.zip
*.png
*.svg
*.vscode
/tabelas_finais/*
!/tabelas_finais/.gitkeep
/mapas/*
!/mapas/.gitkeep
/visualizacoes/*
!/visualizacoes/.gitkeep
*env
/dados_locais/educacao/inep_microdados/

# specs/2026-09-24_website_refactor: *.png/*.svg acima são ignorados globalmente; os assets do site são fonte versionada
!/website/assets/**
# opções de favicon (specs/2026-09-28_melhorias_site U1): fonte de website/build/gera_favicon.py
!/website/build/favicon_opcoes/**


# relatório LaTeX: auxiliares do latexmk e cache de imagens reduzidas (specs/2026-09-25_relatorio_latex)
relatorio/latex/_build/
relatorio/latex/*.aux
relatorio/latex/*.log
relatorio/latex/*.fls
relatorio/latex/*.fdb_latexmk

# specs/2026-10-08_deck_moradia D9: microdado por domicílio do Territórios Sociais (com deficiência) não é versionado;
# o roteiro e as notas da reunião (com nomes) também ficam fora
/apresentacao/variantes/moradia/*.xlsx
/apresentacao/variantes/moradia/*.pdf
/apresentacao/variantes/moradia/stakeholder.md
